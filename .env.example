# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Site ---
# Public base URL of the site, used in ticket emails and QR codes (e.g. https://thefifthevent.com)
NEXT_PUBLIC_URL=

# --- Appwrite (database, storage) ---
NEXT_PUBLIC_ENDPOINT=
NEXT_PUBLIC_APPWRITE_PROJECT=
# Server-side API key (secret)
NEXT_APPWRITE_KEY=
NEXT_PUBLIC_DATABASE=
NEXT_PUBLIC_APPWRITE_BUCKETS_EVENT=

# Collection IDs
NEXT_PUBLIC_APPWRITE_COLLECTION_EVENTS=
NEXT_PUBLIC_APPWRITE_COLLECTION_TICKET=
NEXT_PUBLIC_APPWRITE_COLLECTION_RESERVATION=
NEXT_PUBLIC_APPWRITE_COLLECTION_CUSTOMERS=
NEXT_PUBLIC_APPWRITE_COLLECTION_GALLERY=
NEXT_PUBLIC_APPWRITE_COLLECTION_PROMO_CODES=
NEXT_PUBLIC_APPWRITE_COLLECTION_SCANNERS=
# Optional, default to "contacts" and "providers"
NEXT_PUBLIC_APPWRITE_COLLECTION_CONTACTS=
NEXT_PUBLIC_APPWRITE_COLLECTION_PROVIDERS=

# --- Stripe (payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# --- Resend (emails: tickets, contact form, provider applications) ---
RESEND_API_KEY=
# Sender address, must be verified in Resend. Defaults to info@thefifthevent.com
TICKETING_EMAIL_FROM=

# --- Back office ---
# Password for /admin
ADMIN_PASSWORD=
# Long random string used to sign check-in scanner sessions (/scan)
SCANNER_SESSION_SECRET=
